<UserControl
  x:Class="Desktop.Controls.SecretTextBox"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <Grid>
    <!-- 展示态：只读、可聚焦；获得焦点后立即切到真实编辑框 -->
    <TextBox
      x:Name="MaskedDisplay"
      Classes="Adaline"
      IsReadOnly="True"
    />
    <!-- 编辑态：仅在聚焦时可见，失焦后立即隐藏 -->
    <TextBox
      x:Name="Editor"
      Classes="Adaline"
      IsVisible="False"
    />
  </Grid>
</UserControl>
