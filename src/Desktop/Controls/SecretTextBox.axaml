<UserControl
  x:Class="Desktop.Controls.SecretTextBox"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:motion="clr-namespace:Desktop.Styles"
>
  <Grid>
    <!-- 展示态：只读、可聚焦；获得焦点后立即切到真实编辑框 -->
    <TextBox x:Name="MaskedDisplay" Classes="Adaline" IsReadOnly="True" />
    <!-- 编辑态：仅在聚焦时可见，失焦后立即隐藏 -->
    <TextBox x:Name="Editor" Classes="Adaline" IsVisible="False">
      <TextBox.Transitions>
        <Transitions>
          <DoubleTransition
            Property="Opacity"
            Duration="{x:Static motion:Motion.Fast}"
            Easing="{x:Static motion:Motion.SoftEasing}"
          />
        </Transitions>
      </TextBox.Transitions>
    </TextBox>
  </Grid>
</UserControl>
