<Window
  x:Class="Desktop.Controls.AboutDialog"
  xmlns="https://github.com/avaloniaui"
  xmlns:controls="clr-namespace:Desktop.Controls"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:motion="clr-namespace:Desktop.Styles"
  Title="Mythology — 帮助与关于"
  Width="640"
  Height="520"
  MinWidth="460"
  MinHeight="340"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource BrushLinen}"
  x:DataType="controls:AboutDialog"
  motion:Motion.Enter="True"
>
  <TabControl x:Name="AboutTabs" Padding="0" Background="Transparent" SelectedIndex="0">
    <!-- ═════ 快捷键 ═════ -->
    <TabItem Header="快捷键">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16">
          <ItemsControl ItemsSource="{Binding Shortcuts}" motion:Motion.Stagger="True">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="controls:AboutDialog+Entry">
                <Grid ColumnDefinitions="150,*" Margin="0,3,0,3">
                  <TextBlock
                    Text="{Binding Key}"
                    FontFamily="{StaticResource FontMono}"
                    FontSize="11"
                    Foreground="{DynamicResource BrushOlivePress}"
                    VerticalAlignment="Center"
                  />
                  <TextBlock
                    Grid.Column="1"
                    Text="{Binding Description}"
                    FontSize="13"
                    Foreground="{DynamicResource BrushForestInk}"
                    VerticalAlignment="Center"
                  />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ═════ 命令 ═════ -->
    <TabItem Header="命令">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16">
          <ItemsControl ItemsSource="{Binding Commands}" motion:Motion.Stagger="True">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="controls:AboutDialog+Entry">
                <Grid ColumnDefinitions="150,*" Margin="0,4,0,4">
                  <TextBlock
                    Text="{Binding Key}"
                    FontFamily="{StaticResource FontMono}"
                    FontSize="11"
                    Foreground="{DynamicResource BrushOlivePress}"
                    VerticalAlignment="Center"
                  />
                  <TextBlock
                    Grid.Column="1"
                    Text="{Binding Description}"
                    FontSize="13"
                    Foreground="{DynamicResource BrushForestInk}"
                    VerticalAlignment="Center"
                  />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ═════ 关于 ═════ -->
    <TabItem Header="关于">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,16" MaxWidth="560" HorizontalAlignment="Center" Spacing="24">
          <Border Classes="Card Bone" Padding="20">
            <StackPanel Spacing="6">
              <TextBlock Text="Mythology" Classes="Display" />
              <TextBlock
                Text="AI 小说写作助手"
                FontSize="14"
                Foreground="{DynamicResource BrushSageGray}"
              />
              <Border Height="1" Background="{DynamicResource BrushMist}" Margin="0,6,0,0" />
              <TextBlock
                Text="基于大语言模型的创意写作工具，支持角色、组织、地点、情节线、道具、关系等实体管理，自动追踪变更与审计日志。"
                FontSize="14"
                Foreground="{DynamicResource BrushForestInk}"
                TextWrapping="Wrap"
                LineHeight="21"
              />
            </StackPanel>
          </Border>
          <Border Height="1" Background="{DynamicResource BrushMist}" />
          <TextBlock
            Text="© 2025 奇思妙想科技有限公司&#x0a;本软件及所附创作内容的知识产权归奇思妙想科技有限公司所有。保留所有权利。"
            Classes="Tag"
            FontSize="11"
            Foreground="{DynamicResource BrushSageMist}"
            TextWrapping="Wrap"
            LineHeight="18"
          />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
