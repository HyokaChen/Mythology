<Window
  x:Class="Desktop.Controls.EntityRelationsWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="本体关系"
  Width="520"
  Height="640"
  MinWidth="420"
  MinHeight="400"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource BrushLinen}"
>
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,20,24,16">
    <!-- 标题 -->
    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Classes="Eyebrow" Text="本体关系" />
      <TextBlock
        x:Name="TitleBlock"
        FontSize="18"
        FontWeight="Medium"
        Foreground="{DynamicResource BrushOlivePress}"
        TextWrapping="Wrap"
      />
    </StackPanel>

    <!-- hairline -->
    <Border Grid.Row="1" Height="1" Margin="0,14,0,0" Background="{DynamicResource BrushMist}" />

    <!-- 分节内容（code-behind 构建） -->
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
      <StackPanel x:Name="SectionsPanel" Spacing="14" />
    </ScrollViewer>

    <!-- 底部 -->
    <StackPanel Grid.Row="3" Spacing="12" Margin="0,12,0,0">
      <Border Height="1" Background="{DynamicResource BrushMist}" />
      <Button
        x:Name="CloseButton"
        Classes="Ghost"
        Content="关闭"
        HorizontalAlignment="Right"
        Margin="0,4,0,0"
      />
    </StackPanel>
  </Grid>
</Window>
