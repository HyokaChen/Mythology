<Window
  x:Class="Desktop.Controls.ConfirmDialog"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:motion="clr-namespace:Desktop.Styles"
  x:Name="ConfirmDialogWindow"
  Title="确认操作"
  Width="420"
  Height="200"
  MinWidth="400"
  MinHeight="150"
  CanResize="False"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource BrushLinen}"
  motion:Motion.Enter="True"
>
  <!-- 文本顶置 · 动作条钉在右下（StackPanel 根会让按钮随内容上浮，底部留空） -->
  <Grid RowDefinitions="*,Auto" Margin="24,20,24,20">
    <TextBlock
      x:Name="ConfirmText"
      Grid.Row="0"
      VerticalAlignment="Top"
      FontSize="14"
      Foreground="{DynamicResource BrushForestInk}"
      TextWrapping="Wrap"
      LineHeight="21"
    />
    <StackPanel Grid.Row="1" Spacing="16">
      <Border Height="1" Background="{DynamicResource BrushMist}" />
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Classes="Ghost" Content="取消" Click="CancelButton_OnClick" />
        <Button x:Name="OkButton" Classes="Danger" Content="确认删除" Click="OkButton_OnClick" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
