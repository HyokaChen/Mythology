<Window
  x:Class="Desktop.Controls.AskUserWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Name="AskUserWindowRoot"
  Width="520"
  Height="400"
  MinWidth="460"
  MinHeight="340"
  CanResize="False"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource BrushLinen}"
>
  <!-- 选项卡吃满剩余高度（此前 MaxHeight=210：选项少时框不满、按钮上浮）；动作条钉在右下 -->
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="24,20,24,20">
    <!-- 问题文本 -->
    <TextBlock
      x:Name="QuestionText"
      Grid.Row="0"
      FontSize="14"
      FontWeight="Medium"
      Foreground="{DynamicResource BrushForestInk}"
      TextWrapping="Wrap"
    />

    <!-- 选项区（Card 包裹，填满可用高度） -->
    <Border Grid.Row="1" Classes="Card" Padding="20" Margin="0,16,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="OptionsPanel" Spacing="8" />
      </ScrollViewer>
    </Border>

    <!-- 自定义输入区（单选时显示） -->
    <StackPanel x:Name="CustomPanel" Grid.Row="2" Spacing="6" IsVisible="False" Margin="0,12,0,0">
      <TextBox x:Name="CustomInput" Classes="Adaline" PlaceholderText="输入自定义答案…" />
      <TextBlock
        Text="Enter 确认 · Esc 取消"
        FontSize="10"
        Foreground="{DynamicResource BrushSageMist}"
        FontFamily="{StaticResource FontMono}"
        LetterSpacing="0.2"
        Margin="2,2,0,0"
      />
    </StackPanel>

    <!-- 动作条（右下） -->
    <StackPanel Grid.Row="3" Spacing="12" Margin="0,16,0,0">
      <Border Height="1" Background="{DynamicResource BrushMist}" />
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Classes="Ghost" FontSize="14" Content="取消" />
        <Button x:Name="ConfirmButton" Classes="Primary" FontSize="14" Content="确认" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
