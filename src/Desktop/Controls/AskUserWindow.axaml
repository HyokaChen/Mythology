<Window
  x:Class="Desktop.Controls.AskUserWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:motion="clr-namespace:Desktop.Styles"
  x:Name="AskUserWindowRoot"
  Width="800"
  MinWidth="560"
  MinHeight="280"
  CanResize="True"
  SizeToContent="Height"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource BrushLinen}"
  motion:Motion.Enter="True"
>
  <!-- 一次 ask_user 可能问 1-4 个问题：全部放进同一个窗口，题目按 Header 分组，整组提交。 -->
  <Grid RowDefinitions="*,Auto" Margin="24,20,24,20">
    <ScrollViewer
      Grid.Row="0"
      MaxHeight="620"
      VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled"
    >
      <StackPanel x:Name="QuestionsPanel" Spacing="18" />
    </ScrollViewer>

    <!-- 动作条（右下） -->
    <StackPanel Grid.Row="1" Spacing="10" Margin="0,16,0,0">
      <TextBlock
        x:Name="ValidationText"
        IsVisible="False"
        Text="请先回答所有问题"
        FontSize="12"
        Foreground="{DynamicResource BrushCrimsonSpecimen}"
      />
      <Border Height="1" Background="{DynamicResource BrushMist}" />
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Classes="Ghost" FontSize="14" Content="取消" />
        <Button x:Name="ConfirmButton" Classes="Primary" FontSize="14" Content="确认" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
