<Window
  x:Class="Desktop.Controls.CommandPaletteWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:Desktop.Controls"
  xmlns:motion="clr-namespace:Desktop.Styles"
  Width="640"
  Height="480"
  MinWidth="520"
  MinHeight="400"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource BrushLinen}"
  motion:Motion.Enter="True"
>
  <Window.Styles>
    <!-- ── 表格行：整行是一个按钮，单击即执行 ──
         不用 ListBox：列表的“选中项”会暗示双击/二次确认，而命令面板的交互契约是
         一次点击或一次 Enter。行表面按 DESIGN.md §Code Block Panel 处理——
         无圆角、无独立卡片，只在行间画 1px Mist 分隔线。 -->
    <Style Selector="Button.PaletteRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.PaletteRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource BrushSageMistWash}" />
    </Style>
    <Style Selector="Button.PaletteRow:focus-visible">
      <Setter Property="Background" Value="{DynamicResource BrushSageMistWash}" />
    </Style>
    <!-- 键盘游标：20% Sage Mist 雾 + 行首 “›”，与 hover 的 12% 雾区分。
         只标记“当前执行目标”，不是列表选择态。 -->
    <Style Selector="Button.PaletteRow.current">
      <Setter Property="Background" Value="{DynamicResource BrushSageMistSelected}" />
    </Style>
    <Style Selector="TextBlock.PaletteCursor">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.PaletteRow.current TextBlock.PaletteCursor">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="20,16,20,14">
    <!-- 搜索框 -->
    <TextBox
      x:Name="SearchInput"
      Grid.Row="0"
      Classes="Adaline"
      PlaceholderText="搜索命令…"
      FontSize="14"
      Padding="12,8"
      TextChanged="SearchInput_OnTextChanged"
      KeyDown="SearchInput_OnKeyDown"
    />

    <!-- 命令表：表头固定，行在 ScrollViewer 内滚动 -->
    <Border Grid.Row="1" Classes="Card" Margin="0,10,0,0" Padding="0">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0">
          <!-- 表头宽度跟随行区（含滚动条占位），右对齐的快捷键列才与行一致。 -->
          <Border
            Padding="12,9"
            HorizontalAlignment="Left"
            Width="{Binding #CommandTable.Bounds.Width}"
          >
            <Grid ColumnDefinitions="18,170,*,84">
              <TextBlock Grid.Column="1" Text="命令" Classes="Eyebrow" />
              <TextBlock Grid.Column="2" Text="说明" Classes="Eyebrow" />
              <TextBlock
                Grid.Column="3"
                Text="快捷键"
                Classes="Eyebrow"
                HorizontalAlignment="Right"
              />
            </Grid>
          </Border>
          <Border Height="1" Background="{DynamicResource BrushMist}" />
        </StackPanel>

        <ScrollViewer
          Grid.Row="1"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto"
        >
          <ItemsControl x:Name="CommandTable" motion:Motion.Stagger="True">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="controls:PaletteCommand">
                <Button
                  Classes="PaletteRow"
                  Focusable="False"
                  Click="CommandRow_OnClick"
                  AutomationProperties.Name="{Binding Title}"
                  AutomationProperties.HelpText="{Binding Description}"
                >
                  <!-- SukiUI Button 模板按内容测量；显式撑满按钮宽度，星号列才能铺开。 -->
                  <Grid RowDefinitions="Auto,Auto" Width="{Binding $parent[Button].Bounds.Width}">
                    <Border Grid.Row="0" Padding="12,9">
                      <Grid ColumnDefinitions="18,170,*,84">
                        <TextBlock
                          Classes="PaletteCursor"
                          Text="›"
                          FontFamily="{StaticResource FontMono}"
                          FontSize="12"
                          Foreground="{DynamicResource BrushOlivePress}"
                          VerticalAlignment="Center"
                        />
                        <TextBlock
                          Grid.Column="1"
                          Text="{Binding Title}"
                          FontFamily="{StaticResource FontMono}"
                          FontSize="12"
                          Foreground="{DynamicResource BrushOlivePress}"
                          TextTrimming="CharacterEllipsis"
                          VerticalAlignment="Center"
                        />
                        <TextBlock
                          Grid.Column="2"
                          Text="{Binding Description}"
                          FontSize="13"
                          Foreground="{DynamicResource BrushSageGray}"
                          TextTrimming="CharacterEllipsis"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"
                          ToolTip.Tip="{Binding Description}"
                        />
                        <TextBlock
                          Grid.Column="3"
                          Text="{Binding Shortcut}"
                          FontFamily="{StaticResource FontMono}"
                          FontSize="11"
                          Foreground="{DynamicResource BrushSageGray}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                        />
                      </Grid>
                    </Border>
                    <Border Grid.Row="1" Height="1" Background="{DynamicResource BrushMist}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock
          x:Name="EmptyNote"
          Grid.Row="1"
          Text="没有匹配的命令"
          Classes="Eyebrow"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          IsVisible="False"
        />
      </Grid>
    </Border>

    <!-- 底部提示 -->
    <TextBlock
      Grid.Row="2"
      Text="↑↓ 移动 · Enter 执行 · 单击行执行 · Esc 关闭"
      Classes="Tag"
      Foreground="{DynamicResource BrushSageMist}"
      Margin="2,8,0,0"
    />
  </Grid>
</Window>
