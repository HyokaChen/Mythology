<Window
  x:Class="Desktop.Controls.CommandPaletteWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:Desktop.Controls"
  xmlns:motion="clr-namespace:Desktop.Styles"
  Width="560"
  Height="440"
  MinWidth="480"
  MinHeight="360"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource BrushLinen}"
  motion:Motion.Enter="True"
>
  <Grid RowDefinitions="Auto,*,Auto" Margin="20,16,20,14">
    <!-- 搜索框 -->
    <TextBox
      x:Name="SearchInput"
      Grid.Row="0"
      Classes="Adaline"
      PlaceholderText="搜索命令…"
      FontSize="14"
      Padding="12,8"
      TextChanged="SearchInput_OnTextChanged"
      KeyDown="SearchInput_OnKeyDown"
    />

    <!-- 命令列表 -->
    <Border Grid.Row="1" Classes="Card" Margin="0,10,0,0" Padding="6">
      <ListBox
        x:Name="CommandList"
        Background="Transparent"
        DoubleTapped="CommandList_OnDoubleTapped"
        KeyDown="CommandList_OnKeyDown"
        ItemContainerTheme="{StaticResource AdalineRowContainer}"
          motion:Motion.Stagger="True">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="controls:PaletteCommand">
            <Grid ColumnDefinitions="*,Auto" Margin="4,4" ColumnSpacing="10">
              <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="1">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" />
                <TextBlock
                  Text="{Binding Description}"
                  FontSize="12"
                  Foreground="{DynamicResource BrushSageMist}"
                  IsVisible="{Binding HasDescription}"
                />
              </StackPanel>
              <TextBlock
                x:Name="ShortcutText"
                Grid.Column="1"
                Text="{Binding Shortcut}"
                FontFamily="{StaticResource FontMono}"
                FontSize="11"
                Foreground="{DynamicResource BrushSageGray}"
                VerticalAlignment="Center"
                IsVisible="{Binding HasShortcut}"
              />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- 底部提示 -->
    <TextBlock
      Grid.Row="2"
      Text="↑↓ 导航 · Enter 执行 · Esc 关闭"
      Classes="Tag"
      Foreground="{DynamicResource BrushSageMist}"
      Margin="2,8,0,0"
    />
  </Grid>
</Window>
