<Window
  x:Class="Desktop.Controls.ModelQuickSwitchWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:Desktop.Controls"
  xmlns:motion="clr-namespace:Desktop.Styles"
  Width="520"
  Height="460"
  MinWidth="440"
  MinHeight="360"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource BrushLinen}"
  motion:Motion.Enter="True"
>
  <Grid RowDefinitions="Auto,*,Auto" Margin="20,16,20,14">
    <!-- 搜索框 -->
    <TextBox
      x:Name="SearchInput"
      Grid.Row="0"
      Classes="Adaline"
      PlaceholderText="搜索模型…"
      FontSize="14"
      Padding="12,8"
      TextChanged="SearchInput_OnTextChanged"
      KeyDown="SearchInput_OnKeyDown"
    />

    <!-- 模型列表：加载中显示骨架行，避免先露出只有占位项的 ListBox -->
    <Border Grid.Row="1" Classes="Card" Margin="0,10,0,0" Padding="6">
      <Grid>
        <ListBox
          x:Name="ModelList"
          Background="Transparent"
          Tapped="ModelList_OnTapped"
          ItemContainerTheme="{StaticResource AdalineRowContainer}"
          motion:Motion.Stagger="True"
        >
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="controls:QuickModelItem">
              <Grid ColumnDefinitions="*,Auto" Margin="4,4" ColumnSpacing="10">
                <TextBlock
                  Grid.Column="0"
                  Text="{Binding Name}"
                  FontFamily="{StaticResource FontMono}"
                  FontSize="13"
                  VerticalAlignment="Center"
                />
                <TextBlock
                  Grid.Column="1"
                  Text="当前"
                  Classes="Tag"
                  IsVisible="{Binding HasMarker}"
                  VerticalAlignment="Center"
                />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel
          x:Name="SkeletonPanel"
          IsVisible="False"
          IsHitTestVisible="False"
          Spacing="0"
          Margin="4,2"
        >
          <StackPanel Margin="8,8,0,10" Spacing="3">
            <TextBlock
              Text="MODEL CATALOG"
              Classes="Eyebrow"
              Foreground="{DynamicResource BrushSageMist}"
            />
            <TextBlock
              x:Name="LoadingNote"
              Text="正在获取模型列表…"
              FontSize="12"
              Foreground="{DynamicResource BrushSageGray}"
            />
          </StackPanel>
          <Border
            Height="34"
            BorderBrush="{DynamicResource BrushMist}"
            BorderThickness="0,0,0,1"
            Padding="8,0"
          >
            <Border
              Width="172"
              Height="10"
              Background="{DynamicResource BrushEucalyptus}"
              CornerRadius="4"
              Opacity="0.7"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
            />
          </Border>
          <Border
            Height="34"
            BorderBrush="{DynamicResource BrushMist}"
            BorderThickness="0,0,0,1"
            Padding="8,0"
          >
            <Border
              Width="208"
              Height="10"
              Background="{DynamicResource BrushEucalyptus}"
              CornerRadius="4"
              Opacity="0.7"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
            />
          </Border>
          <Border
            Height="34"
            BorderBrush="{DynamicResource BrushMist}"
            BorderThickness="0,0,0,1"
            Padding="8,0"
          >
            <Border
              Width="148"
              Height="10"
              Background="{DynamicResource BrushEucalyptus}"
              CornerRadius="4"
              Opacity="0.7"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
            />
          </Border>
          <Border
            Height="34"
            BorderBrush="{DynamicResource BrushMist}"
            BorderThickness="0,0,0,1"
            Padding="8,0"
          >
            <Border
              Width="232"
              Height="10"
              Background="{DynamicResource BrushEucalyptus}"
              CornerRadius="4"
              Opacity="0.7"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
            />
          </Border>
          <Border
            Height="34"
            BorderBrush="{DynamicResource BrushMist}"
            BorderThickness="0,0,0,1"
            Padding="8,0"
          >
            <Border
              Width="184"
              Height="10"
              Background="{DynamicResource BrushEucalyptus}"
              CornerRadius="4"
              Opacity="0.7"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
            />
          </Border>
          <Border
            Height="34"
            BorderBrush="{DynamicResource BrushMist}"
            BorderThickness="0,0,0,1"
            Padding="8,0"
          >
            <Border
              Width="200"
              Height="10"
              Background="{DynamicResource BrushEucalyptus}"
              CornerRadius="4"
              Opacity="0.7"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
            />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 底部提示：左侧显示发现中/错误，右侧保持固定键盘提示 -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="2,8,0,0">
      <TextBlock
        x:Name="StatusNote"
        Grid.Column="0"
        Classes="Tag"
        Foreground="{DynamicResource BrushSageMist}"
        TextWrapping="Wrap"
        IsVisible="False"
        VerticalAlignment="Center"
      />
      <TextBlock
        Grid.Column="1"
        Text="↑↓ 导航 · Enter 切换 · Esc 关闭"
        Classes="Tag"
        Foreground="{DynamicResource BrushSageMist}"
        VerticalAlignment="Center"
      />
    </Grid>
  </Grid>
</Window>
