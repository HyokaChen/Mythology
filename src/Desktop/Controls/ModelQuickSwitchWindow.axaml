<Window
  x:Class="Desktop.Controls.ModelQuickSwitchWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:Desktop.Controls"
  xmlns:motion="clr-namespace:Desktop.Styles"
  Width="520"
  Height="460"
  MinWidth="440"
  MinHeight="360"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource BrushLinen}"
  motion:Motion.Enter="True"
>
  <Grid RowDefinitions="Auto,*,Auto" Margin="20,16,20,14">
    <!-- 搜索框 -->
    <TextBox
      x:Name="SearchInput"
      Grid.Row="0"
      Classes="Adaline"
      PlaceholderText="搜索模型…"
      FontSize="14"
      Padding="12,8"
      TextChanged="SearchInput_OnTextChanged"
      KeyDown="SearchInput_OnKeyDown"
    />

    <!-- 模型列表 -->
    <Border Grid.Row="1" Classes="Card" Margin="0,10,0,0" Padding="6">
      <ListBox
        x:Name="ModelList"
        Background="Transparent"
        Tapped="ModelList_OnTapped"
        ItemContainerTheme="{StaticResource AdalineRowContainer}"
        motion:Motion.Stagger="True"
      >
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="controls:QuickModelItem">
            <Grid ColumnDefinitions="*,Auto" Margin="4,4" ColumnSpacing="10">
              <TextBlock
                Grid.Column="0"
                Text="{Binding Name}"
                FontFamily="{StaticResource FontMono}"
                FontSize="13"
                VerticalAlignment="Center"
              />
              <TextBlock
                Grid.Column="1"
                Text="当前"
                Classes="Tag"
                IsVisible="{Binding HasMarker}"
                VerticalAlignment="Center"
              />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- 底部提示 -->
    <TextBlock
      Grid.Row="2"
      Text="↑↓ 导航 · Enter 切换 · Esc 关闭"
      Classes="Tag"
      Foreground="{DynamicResource BrushSageMist}"
      Margin="2,8,0,0"
    />
  </Grid>
</Window>
