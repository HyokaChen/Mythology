<Window
  x:Class="Desktop.Controls.TreeWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:lucide="clr-namespace:Lucide.Avalonia;assembly=Lucide.Avalonia"
  xmlns:controls="clr-namespace:Desktop.Controls"
  xmlns:motion="clr-namespace:Desktop.Styles"
  Width="640"
  Height="560"
  MinWidth="520"
  MinHeight="420"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource BrushLinen}"
  motion:Motion.Enter="True"
>
  <Grid RowDefinitions="*,Auto" Margin="24,20,24,16">
    <!-- 分支行列表 -->
    <Border Grid.Row="0" Classes="Card" Padding="8">
      <ListBox
        x:Name="TreeList"
        Background="Transparent"
        SelectionChanged="TreeList_OnSelectionChanged"
        ItemContainerTheme="{StaticResource AdalineRowContainer}"
          motion:Motion.Stagger="True">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="controls:TreeWindow+TreeRow">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="{Binding IndentMargin}">
              <TextBlock
                Text="{Binding DisplayText}"
                FontSize="13"
                Foreground="{Binding TextBrush}"
                TextTrimming="CharacterEllipsis"
                MaxWidth="330"
                VerticalAlignment="Center"
              />
              <lucide:LucideIcon
                Kind="GitFork"
                Size="11"
                StrokeWidth="1.6"
                Foreground="{DynamicResource BrushSageGray}"
                VerticalAlignment="Center"
                IsVisible="{Binding IsFork}"
              />
              <lucide:LucideIcon
                Kind="ArrowLeft"
                Size="11"
                StrokeWidth="1.8"
                Foreground="{DynamicResource BrushSageLeaf}"
                VerticalAlignment="Center"
                IsVisible="{Binding IsActive}"
              />
              <lucide:LucideIcon
                Kind="Tag"
                Size="11"
                StrokeWidth="1.6"
                Foreground="{DynamicResource BrushSageGray}"
                VerticalAlignment="Center"
                IsVisible="{Binding HasLabels}"
              />
              <ItemsControl
                ItemsSource="{Binding Labels}"
                IsVisible="{Binding HasLabels}"
                VerticalAlignment="Center"
          motion:Motion.Stagger="True">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock
                      Text="{Binding}"
                      FontSize="11"
                      Foreground="{DynamicResource BrushSageMist}"
                      Margin="2,0,0,0"
                      VerticalAlignment="Center"
                    />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- 底部操作区 -->
    <StackPanel Grid.Row="1" Spacing="8" Margin="0,12,0,0">
      <!-- 内嵌标签面板（默认收起） -->
      <StackPanel x:Name="LabelPanel" Orientation="Horizontal" Spacing="8" IsVisible="False">
        <TextBox
          x:Name="LabelInput"
          Classes="Adaline"
          FontSize="13"
          Padding="10,5"
          PlaceholderText="标签文本（如：悲剧线）"
          MinWidth="220"
        />
        <Button
          Classes="Ghost"
          Padding="14,6"
          FontSize="13"
          Content="确认标签"
          Click="LabelConfirm_OnClick"
        />
      </StackPanel>

      <TextBlock
        x:Name="GuardText"
        Classes="Tag"
        Foreground="{DynamicResource BrushAmberPin}"
        IsVisible="False"
      />

      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
        <Button
          Grid.Column="0"
          Classes="NavPill"
          Padding="12,6"
          FontSize="13"
          Click="LabelToggle_OnClick"
        >
          <StackPanel Orientation="Horizontal" Spacing="4">
            <lucide:LucideIcon Kind="Tag" Size="12" StrokeWidth="1.6" VerticalAlignment="Center" />
            <TextBlock Text="添加标签" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button
          x:Name="SummaryButton"
          Grid.Column="1"
          Classes="Ghost"
          Padding="12,6"
          FontSize="13"
          Content="分支 + 摘要"
          Click="SummaryButton_OnClick"
        />
        <Button
          x:Name="SwitchButton"
          Grid.Column="3"
          Classes="Primary"
          Content="切换到此分支"
          Click="SwitchButton_OnClick"
        />
      </Grid>

      <TextBlock
        Text="双击 / Enter 直接分支 · s 分支并生成摘要 · l 标签 · Esc 关闭"
        Classes="Tag"
        Foreground="{DynamicResource BrushSageMist}"
      />
    </StackPanel>
  </Grid>
</Window>
