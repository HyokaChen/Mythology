<Window
  x:Class="Desktop.Controls.EntityEditWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Name="EntityEditWindowRoot"
  Width="620"
  Height="760"
  MinWidth="520"
  MinHeight="560"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource BrushLinen}"
>
  <Grid RowDefinitions="*,Auto,Auto">
    <!-- 动态 Tab 内容区（由代码构建） -->
    <TabControl x:Name="EntityTabControl" Grid.Row="0" Padding="0" Background="Transparent" />

    <!-- 章节「内容」作用域：无标签行、整块铺满的正文编辑器（对齐 TUI：内容直接全部铺满） -->
    <Panel x:Name="ContentFillHost" Grid.Row="0" IsVisible="False" />

    <!-- 底部 hairline 分隔线 -->
    <Border Grid.Row="1" Height="1" Background="{DynamicResource BrushMist}" Margin="20,0" />

    <!-- 底部动作条（DESIGN.md：次级在左 · Primary 居右 · 12px 间隔） -->
    <Grid Grid.Row="2" Margin="20,16,20,16" ColumnDefinitions="*,Auto">
      <TextBlock
        x:Name="FooterLabel"
        Grid.Column="0"
        FontFamily="{StaticResource FontMono}"
        FontSize="10"
        Foreground="{DynamicResource BrushSageMist}"
        VerticalAlignment="Center"
      />
      <StackPanel
        Grid.Column="1"
        x:Name="FooterButtons"
        Orientation="Horizontal"
        Spacing="12"
        VerticalAlignment="Center"
      >
        <Button x:Name="CancelButton" Classes="Ghost" Content="取消" />
        <Button x:Name="SaveButton" Classes="Primary" Content="保存" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
