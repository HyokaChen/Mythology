<Window
  x:Class="Desktop.Controls.SessionManagerWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="clr-namespace:Desktop.Controls"
  Title="会话"
  Width="560"
  Height="560"
  MinWidth="480"
  MinHeight="460"
  CanResize="False"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource BrushLinen}"
>
  <Grid Margin="32,32,32,24" RowSpacing="20" RowDefinitions="Auto,*,Auto">
    <!-- ═══════ 标题区：SectionHeading + 提示 + hairline ═══════ -->
    <StackPanel Grid.Row="0" Spacing="6">
      <TextBlock Text="会话" Classes="SectionHeading" />
      <TextBlock
        Text="最近更新在前 · 双击或回车打开"
        FontSize="14"
        LineHeight="20"
        Foreground="{DynamicResource BrushSageGray}"
      />
      <Border Height="1" Background="{DynamicResource BrushMist}" Margin="0,6,0,0" />
    </StackPanel>

    <!-- ═══════ 列表区：Card 列表 + 空状态提示（叠加） ═══════
         行表面按 DESIGN.md §Code Block Panel：「inner rows separated by 1px dividers」——
         列表是表，不是一摞卡片：行本身无边框无底色，状态雾与分隔线都由 ListBoxItem 出。 -->
    <Grid Grid.Row="1">
      <Border x:Name="ListCard" Classes="Card" Padding="0">
        <ListBox
          x:Name="SessionList"
          FontSize="16"
          Background="Transparent"
          HorizontalAlignment="Stretch"
          ItemContainerTheme="{StaticResource AdalineRowContainer}"
        >
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="c:SessionRow">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="16,12">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock
                    Text="{Binding Title}"
                    FontSize="16"
                    LineHeight="24"
                    FontWeight="Medium"
                    Foreground="{DynamicResource BrushForestInk}"
                    TextTrimming="CharacterEllipsis"
                  />
                  <TextBlock
                    FontFamily="{StaticResource FontMono}"
                    FontSize="11"
                    LineHeight="16"
                    Foreground="{DynamicResource BrushSageMist}"
                    TextTrimming="CharacterEllipsis"
                    Text="{Binding Meta}"
                  />
                </StackPanel>
                <!-- 当前标记：实心 Sage Leaf 徽标 + Linen 字（DESIGN.md §Tokens "badge fills"） -->
                <Border
                  Grid.Column="1"
                  Classes="TagPillSolid"
                  IsVisible="{Binding IsCurrent}"
                  VerticalAlignment="Center"
                >
                  <TextBlock Classes="Tag" Text="当前" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <Border
        x:Name="EmptyNote"
        Classes="EmptyNote"
        IsVisible="False"
        VerticalAlignment="Top"
        Margin="0,4,0,0"
      >
        <StackPanel Spacing="6">
          <TextBlock
            Text="还没有会话记录"
            FontSize="18"
            LineHeight="26"
            FontWeight="Medium"
            Foreground="{DynamicResource BrushForestInk}"
          />
          <TextBlock
            Text="在主界面开始一段对话，之后就能从这里切回来。"
            FontSize="16"
            LineHeight="24"
            Foreground="{DynamicResource BrushSageGray}"
            TextWrapping="Wrap"
            HorizontalAlignment="Left"
          />
        </StackPanel>
      </Border>
    </Grid>

    <!-- ═══════ 底部：计数（左，上下文元数据） + 动作（右，唯一 Primary） ═══════ -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
      <TextBlock
        x:Name="CountNote"
        Grid.Column="0"
        FontFamily="{StaticResource FontMono}"
        FontSize="11"
        LineHeight="16"
        Foreground="{DynamicResource BrushSageMist}"
        VerticalAlignment="Center"
      />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
        <Button
          x:Name="DeleteButton"
          Classes="Ghost"
          FontSize="14"
          Content="删除"
          IsEnabled="False"
        />
        <Button
          x:Name="OpenButton"
          Classes="Primary"
          FontSize="14"
          Content="打开"
          IsEnabled="False"
        />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
