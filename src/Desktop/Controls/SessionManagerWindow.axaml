<Window
  x:Class="Desktop.Controls.SessionManagerWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="clr-namespace:Desktop.Controls"
  Title="会话"
  Width="560"
  Height="560"
  MinWidth="480"
  MinHeight="460"
  CanResize="False"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource BrushLinen}"
>
  <Grid Margin="32,32,32,24" RowSpacing="20" RowDefinitions="Auto,*,Auto">
    <!-- ═══════ 标题区：SectionHeading + 提示 + hairline ═══════ -->
    <StackPanel Grid.Row="0" Spacing="6">
      <TextBlock Text="会话" Classes="SectionHeading" />
      <TextBlock
        Text="最近更新在前 · 双击或回车打开"
        FontSize="14"
        Foreground="{DynamicResource BrushSageGray}"
      />
      <Border Height="1" Background="{DynamicResource BrushMist}" Margin="0,6,0,0" />
    </StackPanel>

    <!-- ═══════ 列表区：Card 列表 + 空状态提示（叠加） ═══════ -->
    <Grid Grid.Row="1">
      <Border Classes="Card" Padding="8">
        <ListBox
          x:Name="SessionList"
          FontSize="14"
          Background="Transparent"
          HorizontalAlignment="Stretch"
        >
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="c:SessionRow">
              <Border
                Classes="Card"
                CornerRadius="{StaticResource RadiusCardsSm}"
                Padding="12,9"
                Margin="0,0,0,6"
                Background="{DynamicResource BrushSurfaceGlow}"
              >
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock
                      Text="{Binding Title}"
                      FontSize="13.5"
                      FontWeight="Medium"
                      Foreground="{DynamicResource BrushForestInk}"
                      TextTrimming="CharacterEllipsis"
                    />
                    <TextBlock
                      FontFamily="{StaticResource FontMono}"
                      FontSize="10"
                      Foreground="{DynamicResource BrushSageMist}"
                      Text="{Binding Meta}"
                    />
                  </StackPanel>
                  <Border
                    Grid.Column="1"
                    Classes="TagPill"
                    IsVisible="{Binding IsCurrent}"
                    VerticalAlignment="Center"
                  >
                    <TextBlock Classes="Tag" Text="当前" />
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <Border
        x:Name="EmptyNote"
        Classes="EmptyNote"
        IsVisible="False"
        VerticalAlignment="Top"
        Margin="0,4,0,0"
      >
        <StackPanel Spacing="6">
          <TextBlock
            Text="还没有会话记录"
            FontSize="16"
            FontWeight="Medium"
            Foreground="{DynamicResource BrushForestInk}"
          />
          <TextBlock
            Text="在主界面开始一段对话，之后就能从这里切回来。"
            FontSize="14"
            Foreground="{DynamicResource BrushSageGray}"
            TextWrapping="Wrap"
            MaxWidth="360"
          />
        </StackPanel>
      </Border>
    </Grid>

    <!-- ═══════ 底部：计数（左，上下文元数据） + 动作（右，唯一 Primary） ═══════ -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
      <TextBlock
        x:Name="CountNote"
        Grid.Column="0"
        FontFamily="{StaticResource FontMono}"
        FontSize="10.5"
        Foreground="{DynamicResource BrushSageMist}"
        VerticalAlignment="Center"
      />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
        <Button
          x:Name="DeleteButton"
          Classes="Ghost"
          FontSize="14"
          Content="删除"
          IsEnabled="False"
        />
        <Button
          x:Name="OpenButton"
          Classes="Primary"
          FontSize="14"
          Content="打开"
          IsEnabled="False"
        />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
