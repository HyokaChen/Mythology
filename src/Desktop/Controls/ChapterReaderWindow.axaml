<Window
  x:Class="Desktop.Controls.ChapterReaderWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:lucide="clr-namespace:Lucide.Avalonia;assembly=Lucide.Avalonia"
  xmlns:motion="clr-namespace:Desktop.Styles"
  Title="章节内容"
  Width="820"
  Height="720"
  MinWidth="640"
  MinHeight="540"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource BrushLinen}"
  motion:Motion.Enter="True"
>
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
    <!-- ── 头部：Eyebrow + 标题 + 元数据；右侧只留翻页 ── -->
    <Grid Grid.Row="0" Margin="24,20,24,0" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Spacing="1">
        <TextBlock x:Name="EyebrowText" Classes="Eyebrow" Text="CHAPTER" />
        <TextBlock
          x:Name="TitleBlock"
          Classes="DialogTitle"
          FontWeight="Medium"
          TextTrimming="CharacterEllipsis"
          TextWrapping="NoWrap"
        />
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
          <TextBlock
            x:Name="StatusTag"
            Classes="Tag"
            Foreground="{DynamicResource BrushSageMist}"
          />
          <TextBlock
            x:Name="WordCountBlock"
            Classes="Tag"
            Foreground="{DynamicResource BrushSageMist}"
          />
          <TextBlock
            x:Name="ScopeTag"
            Classes="Tag"
            Foreground="{DynamicResource BrushSageMist}"
            IsVisible="False"
          />
          <TextBlock
            x:Name="DirtyTag"
            Classes="Tag"
            Foreground="{DynamicResource BrushAmberPin}"
            Text="未保存"
            IsVisible="False"
          />
        </StackPanel>
      </StackPanel>
      <StackPanel
        Grid.Column="1"
        Orientation="Horizontal"
        Spacing="6"
        VerticalAlignment="Top"
        Margin="16,2,0,0"
      >
        <Button x:Name="PrevButton" Classes="NavPill" Padding="10,4" IsEnabled="False">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <lucide:LucideIcon
              Kind="ChevronLeft"
              Size="14"
              StrokeWidth="1.8"
              VerticalAlignment="Center"
            />
            <TextBlock Text="上一章" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="NextButton" Classes="NavPill" Padding="10,4" IsEnabled="False">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="下一章" VerticalAlignment="Center" />
            <lucide:LucideIcon
              Kind="ChevronRight"
              Size="14"
              StrokeWidth="1.8"
              VerticalAlignment="Center"
            />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Height="1" Background="{DynamicResource BrushMist}" Margin="24,16,24,0" />

    <!-- ── 细纲：Bone 卡，点击整行展开 / 收起 ── -->
    <Border x:Name="OutlinePanel" Grid.Row="2" Classes="Card" Margin="24,12,24,0" IsVisible="False">
      <StackPanel>
        <Button
          x:Name="OutlineToggle"
          Classes="ListActionRow"
          Click="OnOutlineToggle_Click"
          HorizontalContentAlignment="Stretch"
          ToolTip.Tip="展开 / 收起细纲"
        >
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
              <lucide:LucideIcon
                x:Name="OutlineChevron"
                Kind="ChevronRight"
                Size="13"
                StrokeWidth="1.8"
                Foreground="{DynamicResource BrushSageGray}"
                VerticalAlignment="Center"
              />
              <TextBlock Grid.Column="1" Text="细纲" Classes="Eyebrow" VerticalAlignment="Center" />
              <TextBlock
                Grid.Column="3"
                x:Name="OutlineMeta"
                FontFamily="{StaticResource FontMono}"
                FontSize="10"
                Foreground="{DynamicResource BrushSageMist}"
                VerticalAlignment="Center"
              />
            </Grid>
            <TextBlock
              x:Name="OutlineTeaser"
              Margin="21,0,0,0"
              FontSize="12"
              Foreground="{DynamicResource BrushSageGray}"
              TextTrimming="CharacterEllipsis"
              TextWrapping="NoWrap"
            />
          </StackPanel>
        </Button>
        <!-- 展开态限高滚动：细纲再长也不把正文编辑区挤没 -->
        <ScrollViewer
          x:Name="OutlineDetails"
          IsVisible="False"
          MaxHeight="220"
          Margin="16,0,16,14"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto"
        >
          <StackPanel Spacing="8">
            <Border Height="1" Background="{DynamicResource BrushMist}" Margin="0,0,0,2" />
            <TextBlock
              x:Name="SummaryText"
              FontSize="13"
              Foreground="{DynamicResource BrushForestInk}"
              TextWrapping="Wrap"
              IsVisible="False"
            />
            <WrapPanel x:Name="ChipsPanel" ItemSpacing="4" LineSpacing="4" />
            <TextBlock
              x:Name="RecordsText"
              FontFamily="{StaticResource FontMono}"
              FontSize="10"
              Foreground="{DynamicResource BrushSageMist}"
              TextWrapping="Wrap"
              IsVisible="False"
            />
          </StackPanel>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <!-- ── 正文：SurfaceGlow 稿纸卡；默认可直接编辑 ── -->
    <Border Grid.Row="3" Classes="Card Glow" Margin="24,12,24,12" Padding="20,14">
      <Grid RowDefinitions="Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="正文" Classes="Eyebrow" />
          <TextBlock
            Grid.Column="1"
            Text="⌘/Ctrl+S 保存"
            FontFamily="{StaticResource FontMono}"
            FontSize="10"
            Foreground="{DynamicResource BrushSageMist}"
          />
        </Grid>
        <TextBox
          x:Name="ContentEditor"
          Grid.Row="1"
          Classes="PromptBox"
          AcceptsReturn="True"
          TextWrapping="Wrap"
          VerticalContentAlignment="Top"
          TextAlignment="Justify"
          FontSize="15"
          VerticalAlignment="Stretch"
        />
      </Grid>
    </Border>

    <!-- ── 底栏：左说明，右取消 / 保存 ── -->
    <StackPanel Grid.Row="4" Spacing="10" Margin="24,0,24,16">
      <Border Height="1" Background="{DynamicResource BrushMist}" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock
          Grid.Column="0"
          Text="切换章节会提示保存"
          FontFamily="{StaticResource FontMono}"
          FontSize="10"
          Foreground="{DynamicResource BrushSageMist}"
          VerticalAlignment="Center"
        />
        <StackPanel
          Grid.Column="1"
          Orientation="Horizontal"
          Spacing="12"
          HorizontalAlignment="Right"
        >
          <Button x:Name="CloseButton" Classes="Ghost" Content="取消" />
          <Button x:Name="SaveButton" Classes="Primary" Content="保存" IsEnabled="False" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
