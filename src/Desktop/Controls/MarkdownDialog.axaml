<Window
  x:Class="Desktop.Controls.MarkdownDialog"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
  xmlns:motion="clr-namespace:Desktop.Styles"
  x:Name="MarkdownWindow"
  Width="640"
  Height="520"
  MinWidth="460"
  MinHeight="340"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource BrushLinen}"
  motion:Motion.Enter="True"
>
  <ScrollViewer
    x:Name="MarkdownScroller"
    HorizontalScrollBarVisibility="Disabled"
    VerticalScrollBarVisibility="Auto"
  >
    <md:MarkdownRenderer
      x:Name="MarkdownRenderer"
      CodeBlockColorTheme="LightPlus"
      Margin="20,16,20,16"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
    />
  </ScrollViewer>
</Window>
