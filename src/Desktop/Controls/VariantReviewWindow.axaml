<Window
  x:Class="Desktop.Controls.VariantReviewWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
  Width="720"
  Height="560"
  MinWidth="560"
  MinHeight="420"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource BrushLinen}"
>
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,20,24,16">
    <!-- 目标行 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
      <TextBlock x:Name="TargetText" Classes="Tag" VerticalAlignment="Center" />
    </StackPanel>

    <!-- 变体 Tab 条（code-behind 构建） -->
    <StackPanel
      x:Name="TabBar"
      Grid.Row="1"
      Orientation="Horizontal"
      Spacing="6"
      Margin="0,10,0,0"
    />
    <Border Grid.Row="2" Classes="Card" Margin="0,10,0,0" Padding="16">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <md:MarkdownRenderer x:Name="ContentMarkdown" CodeBlockColorTheme="LightPlus" />
      </ScrollViewer>
    </Border>

    <!-- 操作按钮行 -->
    <StackPanel
      Grid.Row="3"
      Orientation="Horizontal"
      Spacing="12"
      HorizontalAlignment="Right"
      Margin="0,14,0,0"
    >
      <TextBlock
        Text="← → 切换变体 · Esc 稍后决定"
        Classes="Tag"
        VerticalAlignment="Center"
        Foreground="{DynamicResource BrushSageMist}"
      />
      <Button
        x:Name="RefineButton"
        Classes="Ghost"
        Content="继续修改"
        Click="RefineButton_OnClick"
      />
      <Button x:Name="ApplyButton" Classes="Primary" Click="ApplyButton_OnClick" />
    </StackPanel>
  </Grid>
</Window>
