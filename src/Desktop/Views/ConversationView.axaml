<UserControl
  x:Class="Desktop.Views.ConversationView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:Desktop.Controls"
  xmlns:conv="clr-namespace:Desktop.Converters"
  xmlns:lucide="clr-namespace:Lucide.Avalonia;assembly=Lucide.Avalonia"
  xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
  xmlns:models="clr-namespace:Desktop.Models"
  xmlns:motion="clr-namespace:Desktop.Styles"
  xmlns:vm="clr-namespace:Desktop.ViewModels"
  x:DataType="vm:ConversationViewModel"
>
  <UserControl.Resources>
    <conv:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibility" />
    <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
    <conv:ObservableStringBuilderToStringConverter x:Key="StringBuilderToString" />
    <conv:SenderToBoolConverter x:Key="IsUser" />
    <conv:SenderToBoolConverter x:Key="IsAgent" />
    <conv:SenderToBoolConverter x:Key="IsSystem" />
    <!-- 正文只有一种模板：LiveMarkdown。历史与实时同构，不做纯文本降级。 -->
    <DataTemplate x:Key="RichAgentBody" x:DataType="models:ChatMessage">
      <controls:VirtualizedMarkdownBody MarkdownBuilder="{Binding Content}" />
    </DataTemplate>

    <DataTemplate x:Key="RowUser" x:DataType="models:ConversationRow">
      <Grid
        Classes="MessageHoverHost"
        Margin="{Binding Margin}"
        HorizontalAlignment="Right"
        Background="Transparent"
      >
        <StackPanel
          Spacing="3"
          HorizontalAlignment="Right"
          IsVisible="{Binding Message.IsEditing, Converter={StaticResource InvertedBoolToVisibility}}"
        >
          <TextBlock Classes="Eyebrow" HorizontalAlignment="Right" Text="你" />
          <Border Classes="UserBubble" HorizontalAlignment="Right">
            <SelectableTextBlock
              Text="{Binding Message.Content, Converter={StaticResource StringBuilderToString}}"
              TextWrapping="Wrap"
            />
          </Border>
          <controls:MessageActionBar
            Classes="MessageActions"
            Classes.Hovered="{Binding Message.IsPointerOverMessage}"
            HorizontalAlignment="Right"
            ShowEdit="True"
            EditRequested="UserMessageEdit_OnRequested"
          />
        </StackPanel>

        <!-- 编辑态：原气泡原位变成内联输入框，取消不写回、发送走「编辑后重发」分支。 -->
        <StackPanel Spacing="3" HorizontalAlignment="Right" IsVisible="{Binding Message.IsEditing}">
          <TextBlock Classes="Eyebrow" HorizontalAlignment="Right" Text="编辑消息" />
          <Border Classes="UserEditCard" HorizontalAlignment="Right" MinWidth="420" MaxWidth="760">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
              <TextBox
                x:Name="UserEditBox"
                Classes="PromptBox"
                Text="{Binding Message.EditDraft, Mode=TwoWay}"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                MinHeight="40"
                MaxHeight="160"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
              />
              <StackPanel
                Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
              >
                <Button Classes="Ghost" FontSize="13" Padding="12,5" Click="CancelUserEdit_OnClick">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:LucideIcon
                      Kind="X"
                      Size="13"
                      StrokeWidth="1.8"
                      VerticalAlignment="Center"
                    />
                    <TextBlock Text="取消" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button
                  Classes="Primary"
                  FontSize="13"
                  Padding="14,5"
                  Click="SubmitUserEdit_OnClick"
                >
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="发送" VerticalAlignment="Center" />
                    <lucide:LucideIcon
                      Kind="CornerDownLeft"
                      Size="13"
                      StrokeWidth="1.8"
                      VerticalAlignment="Center"
                    />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="RowSystem" x:DataType="models:ConversationRow">
      <Border
        Classes="SystemNoticeCard"
        Classes.Error="{Binding Message.IsError}"
        Margin="{Binding Margin}"
        HorizontalAlignment="Stretch"
      >
        <StackPanel Spacing="3">
          <TextBlock Classes="Eyebrow" HorizontalAlignment="Left" Text="系统" />
          <!-- 压缩等长任务：BusySpinner 与文本同排，任务完成后只关 spinner，不换行不跳动。 -->
          <DockPanel>
            <controls:BusySpinner
              DockPanel.Dock="Left"
              IsActive="{Binding Message.IsSpinnerVisible}"
              IsVisible="{Binding Message.IsSpinnerVisible}"
              FontSize="12"
              Foreground="{DynamicResource BrushSageLeaf}"
              Margin="0,0,8,0"
              VerticalAlignment="Center"
            />
            <SelectableTextBlock
              Classes="SystemNoticeText"
              Text="{Binding Message.Content, Converter={StaticResource StringBuilderToString}}"
              TextAlignment="Left"
              HorizontalAlignment="Stretch"
            />
          </DockPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="RowWaiting" x:DataType="models:ConversationRow">
      <StackPanel
        Margin="{Binding Margin}"
        Orientation="Horizontal"
        Spacing="8"
        Background="Transparent"
        IsVisible="{Binding Message.IsWaiting}"
      >
        <controls:BusySpinner
          IsActive="{Binding Message.IsWaiting}"
          FontSize="12"
          Foreground="{DynamicResource BrushSageLeaf}"
          VerticalAlignment="Center"
        />
        <TextBlock Classes="Eyebrow" Text="执行中" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="RowStep" x:DataType="models:ConversationRow">
      <Grid Classes="MessageHoverHost" Margin="{Binding Margin}" Background="Transparent">
        <StackPanel Spacing="2">
          <Border Classes="AgentBubble" IsVisible="{Binding Step.IsContentStep}" Margin="0,4,0,4">
            <ContentControl
              Content="{Binding Step}"
              ContentTemplate="{StaticResource StepContentMarkdown}"
            />
          </Border>

          <controls:MessageActionBar
            Classes="MessageActions"
            Classes.Hovered="{Binding Message.IsPointerOverMessage}"
            HorizontalAlignment="Left"
            ShowRetry="False"
            IsVisible="{Binding Step.IsContentStep}"
          />

          <Border
            Classes="SystemNoticeCard"
            Classes.Error="{Binding Step.IsError}"
            IsVisible="{Binding Step.IsSystemEvent}"
            Margin="0,2,0,2"
            HorizontalAlignment="Stretch"
          >
            <StackPanel Spacing="3">
              <TextBlock Classes="Eyebrow" HorizontalAlignment="Left" Text="系统" />
              <SelectableTextBlock
                Classes="SystemNoticeText"
                Text="{Binding Step.ContentText}"
                TextAlignment="Left"
              />
            </StackPanel>
          </Border>

          <SelectableTextBlock
            Classes="SystemNoticeText AgentStepNoticeText"
            IsVisible="{Binding Step.IsNoticeStep}"
            Text="{Binding Step.ContentText}"
            TextAlignment="Left"
            Margin="18,1,0,1"
          />

          <StackPanel Spacing="2" IsVisible="{Binding Step.IsStepHeader}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="6" Margin="0,1,0,0">
              <Grid Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center">
                <controls:BusySpinner
                  IsActive="{Binding Step.IsProcessing}"
                  IsVisible="{Binding Step.IsProcessing}"
                  FontSize="12"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                />
                <lucide:LucideIcon
                  Kind="{Binding Step.StatusIcon}"
                  Size="11"
                  StrokeWidth="1.6"
                  IsVisible="{Binding Step.IsProcessing, Converter={StaticResource InvertedBoolToVisibility}}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                />
              </Grid>
              <TextBlock
                Grid.Column="1"
                Text="{Binding Step.Title}"
                Classes="Tag"
                VerticalAlignment="Center"
              />
              <TextBlock
                Grid.Column="2"
                Text="{Binding Step.ArgumentsSummary}"
                FontFamily="{StaticResource FontMono}"
                FontSize="11"
                Foreground="{DynamicResource BrushSageMist}"
                TextWrapping="Wrap"
                VerticalAlignment="Center"
              />
              <Button
                Grid.Column="3"
                Content="{Binding Step.DetailsToggleLabel}"
                IsVisible="{Binding Step.HasDetails}"
                Classes="IconButton"
                Padding="6,1"
                FontSize="11"
                Foreground="{DynamicResource BrushSageLeaf}"
                VerticalAlignment="Center"
                Click="StepDetails_OnClick"
              />
              <Button
                Grid.Column="4"
                Classes="ActionIcon StepHeaderAction"
                Height="20"
                Width="20"
                Padding="3"
                VerticalAlignment="Center"
                ToolTip.Tip="复制此步骤"
                Click="StepCopy_OnClick"
              >
                <lucide:LucideIcon Kind="Copy" Size="12" StrokeWidth="1.6" />
              </Button>
            </Grid>
            <SelectableTextBlock
              Text="{Binding Step.ResultSummary}"
              IsVisible="{Binding Step.HasResult}"
              FontSize="11"
              Foreground="{DynamicResource BrushSageGray}"
              TextWrapping="Wrap"
              Margin="18,0,0,0"
            />
            <!-- 流式思考只显示固定两行尾部预览：底部对齐 + 裁剪，最新行始终在底部。 -->
            <controls:StreamingReasoningPreview
              IsVisible="{Binding Step.ShowStreamingPreview}"
              Text="{Binding Step.ReasoningPreview}"
              TextForeground="{DynamicResource BrushSageGray}"
              Margin="18,0,0,0"
            />
            <StackPanel
              Classes="StepDetails"
              IsVisible="{Binding Step.IsDetailsExpanded}"
              Spacing="4"
              Margin="18,2,0,0"
              HorizontalAlignment="Stretch"
            >
              <ScrollViewer
                IsVisible="{Binding Step.HasThinking}"
                MaxHeight="320"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
              >
                <SelectableTextBlock
                  Text="{Binding Step.ThinkingText}"
                  FontSize="12"
                  Foreground="{DynamicResource BrushSageGray}"
                  TextWrapping="Wrap"
                />
              </ScrollViewer>
              <TextBlock
                Text="参数"
                Classes="Eyebrow"
                IsVisible="{Binding Step.HasDetailArguments}"
              />
              <ScrollViewer
                IsVisible="{Binding Step.HasDetailArguments}"
                MaxHeight="240"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
              >
                <SelectableTextBlock
                  Text="{Binding Step.DetailArguments}"
                  FontFamily="{StaticResource FontMono}"
                  FontSize="11"
                  Foreground="{DynamicResource BrushSageGray}"
                  TextWrapping="Wrap"
                />
              </ScrollViewer>
              <TextBlock Text="结果" Classes="Eyebrow" IsVisible="{Binding Step.HasResultDetail}" />
              <ScrollViewer
                IsVisible="{Binding Step.ShowRawResultDetail}"
                MaxHeight="320"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
              >
                <SelectableTextBlock
                  Text="{Binding Step.DetailResult}"
                  FontFamily="{StaticResource FontMono}"
                  FontSize="11"
                  Foreground="{DynamicResource BrushSageGray}"
                  TextWrapping="Wrap"
                />
              </ScrollViewer>
              <StackPanel IsVisible="{Binding Step.HasDiff}" Spacing="2" Margin="0,2,0,0">
                <TextBlock Text="{Binding Step.DiffSummary}" Classes="Eyebrow" />
                <ScrollViewer
                  MaxHeight="320"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                >
                  <ItemsControl ItemsSource="{Binding Step.DiffLines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:DiffLineView">
                        <Border
                          Classes="DiffRow"
                          Classes.DiffDelete="{Binding IsDelete}"
                          Classes.DiffInsert="{Binding IsInsert}"
                        >
                          <Grid ColumnDefinitions="Auto,Auto,*">
                            <TextBlock
                              Classes="DiffText DiffPrefix"
                              Classes.DiffDelete="{Binding IsDelete}"
                              Classes.DiffInsert="{Binding IsInsert}"
                              Text="{Binding Prefix}"
                            />
                            <TextBlock
                              Grid.Column="1"
                              Classes="DiffText DiffLineNumber"
                              Classes.DiffDelete="{Binding IsDelete}"
                              Classes.DiffInsert="{Binding IsInsert}"
                              Text="{Binding LineNumber}"
                            />
                            <TextBlock
                              Grid.Column="2"
                              Classes="DiffText"
                              Classes.DiffDelete="{Binding IsDelete}"
                              Classes.DiffInsert="{Binding IsInsert}"
                              Text="{Binding Text}"
                              TextWrapping="Wrap"
                            />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ConversationRowRoot" x:DataType="models:ConversationRow">
      <ContentControl
        Content="{Binding}"
        ContentTemplate="{Binding Kind, Converter={StaticResource ConversationRowTemplate}}"
      />
    </DataTemplate>

    <DataTemplate x:Key="StepContentMarkdown" x:DataType="models:AgentStep">
      <md:MarkdownRenderer
        Classes="ConversationMarkdown StepContentMarkdown"
        MarkdownBuilder="{Binding ContentMarkdown}"
        CodeBlockColorTheme="LightPlus"
      />
    </DataTemplate>

    <DataTemplate x:Key="RowContent" x:DataType="models:ConversationRow">
      <Grid Classes="MessageHoverHost" Margin="{Binding Margin}" Background="Transparent">
        <Border
          Classes="AgentBubble"
          HorizontalAlignment="Stretch"
          IsVisible="{Binding Message.HasVisibleContent}"
        >
          <ContentControl
            Content="{Binding Message}"
            ContentTemplate="{StaticResource RichAgentBody}"
          />
        </Border>
      </Grid>
    </DataTemplate>

    <!-- 每轮助手回复唯一的动作行：放在回合最末尾（正文/步骤/中断/来源之后），
         由消息级 hover 唤出；有无正文都只有这一条复制/重试。 -->
    <DataTemplate x:Key="RowActions" x:DataType="models:ConversationRow">
      <Grid Margin="{Binding Margin}" Background="Transparent">
        <controls:MessageActionBar
          Classes="MessageActions"
          Classes.Hovered="{Binding Message.IsPointerOverMessage}"
          HorizontalAlignment="Left"
          ShowRetry="True"
          RetryRequested="MessageRetry_On_Requested"
        />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="RowInterrupted" x:DataType="models:ConversationRow">
      <StackPanel
        Margin="{Binding Margin}"
        Spacing="3"
        Background="Transparent"
        IsVisible="{Binding Message.IsInterrupted}"
      >
        <TextBlock Classes="Eyebrow" HorizontalAlignment="Left" Text="系统" />
        <TextBlock Classes="SystemNoticeText" Text="⏹ 中断生成" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="RowProcess" x:DataType="models:ConversationRow">
      <Button
        Margin="{Binding Margin}"
        Classes="IconButton"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        Padding="0,2"
        Click="ProcessRow_OnClick"
      >
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
          <TextBlock Classes="Eyebrow" Text="过程" VerticalAlignment="Center" />
          <TextBlock
            Grid.Column="1"
            Text="{Binding Message.ProcessSummary}"
            FontSize="11"
            Foreground="{DynamicResource BrushSageMist}"
            TextWrapping="Wrap"
            VerticalAlignment="Center"
          />
          <lucide:LucideIcon
            Grid.Column="2"
            Kind="ChevronRight"
            Size="12"
            StrokeWidth="1.6"
            VerticalAlignment="Center"
          />
        </Grid>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="RowSources" x:DataType="models:ConversationRow">
      <ItemsControl
        Margin="{Binding Margin}"
        ItemsSource="{Binding Message.Sources}"
        IsVisible="{Binding Message.Sources.Count, Converter={StaticResource CountToVisibility}}"
      >
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:SourceInfo">
            <TextBlock
              FontFamily="{StaticResource FontMono}"
              FontSize="11"
              Foreground="{DynamicResource BrushSageMist}"
              Text="{Binding Title}"
            />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>

    <conv:ConversationRowTemplateConverter
      x:Key="ConversationRowTemplate"
      UserTemplate="{StaticResource RowUser}"
      SystemTemplate="{StaticResource RowSystem}"
      WaitingTemplate="{StaticResource RowWaiting}"
      StepTemplate="{StaticResource RowStep}"
      ContentTemplate="{StaticResource RowContent}"
      InterruptedTemplate="{StaticResource RowInterrupted}"
      SourcesTemplate="{StaticResource RowSources}"
      ProcessTemplate="{StaticResource RowProcess}"
      ActionsTemplate="{StaticResource RowActions}"
    />
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- 消息块动作条：由 ChatMessage.IsPointerOverMessage（消息级 hover）控制。
         指针落在该消息任意一行（正文/步骤/中断行/动作行）都显示，避免无正文回合找不到按钮。 -->
    <Style Selector="controls|MessageActionBar.MessageActions">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition
            Property="Opacity"
            Duration="{x:Static motion:Motion.Fast}"
            Easing="SineEaseOut"
          />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="controls|MessageActionBar.MessageActions.Hovered">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Grid.MessageHoverHost Button.StepHeaderAction">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition
            Property="Opacity"
            Duration="{x:Static motion:Motion.Fast}"
            Easing="SineEaseOut"
          />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Grid.MessageHoverHost:pointerover Button.StepHeaderAction">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <!-- 用户消息内联编辑：原位替换气泡，但不使用用户气泡的深色填充。 -->
    <Style Selector="Border.UserEditCard">
      <Setter Property="Background" Value="{DynamicResource BrushSurfaceGlow}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrushLichen}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <!-- 深色用户气泡里的选区：统一到 Eucalyptus + Forest Ink，避免系统蓝与纸面色板冲突。 -->
    <Style Selector="Border.UserBubble SelectableTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BrushLinen}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="LineHeight" Value="24" />
      <Setter Property="SelectionBrush" Value="{DynamicResource BrushEucalyptus}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource BrushForestInk}" />
    </Style>
    <!-- Markdown 正文可拖选复制；选区同样走设计系统色。 -->
    <Style Selector="SelectableTextBlock">
      <Setter Property="SelectionBrush" Value="{DynamicResource BrushEucalyptus}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource BrushForestInk}" />
    </Style>
    <Style Selector="md|MarkdownRenderer md|MarkdownTextBlock">
      <Setter Property="SelectionBrush" Value="{DynamicResource BrushEucalyptus}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource BrushForestInk}" />
    </Style>

    <!-- 最终答复正文：LiveMarkdown 默认 14px/紧凑行高，统一到 DESIGN.md 的 16/24。 -->
    <Style Selector="md|MarkdownRenderer.ConversationMarkdown md|MarkdownTextBlock:not(.CodeBlockText)">
      <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="LineHeight" Value="24" />
      <Setter Property="Foreground" Value="{DynamicResource BrushOlivePress}" />
    </Style>
    <Style Selector="md|MarkdownRenderer.ConversationMarkdown md|MarkdownTextBlock.ParagraphBlock">
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <!-- 中间正文：只做时间线留痕，字号小于最终答复；外层复用 AgentBubble 的
         Bone 卡片（16/12 padding），用 LiveMarkdown 渲染，避免出现裸 Markdown 标记。 -->
    <Style Selector="md|MarkdownRenderer.StepContentMarkdown md|MarkdownTextBlock:not(.CodeBlockText)">
      <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="LineHeight" Value="24" />
      <Setter Property="Foreground" Value="{DynamicResource BrushOlivePress}" />
    </Style>
    <!-- 引用块不再嵌套第二张卡片：Markdown 默认深灰底 + 本文件的深色正文会变成深底深字，
         放进 AgentBubble 后还会形成双层边框。引用语义由 LiveMarkdown 的「▎」前缀承担，
         这里只清掉底色和边框。 -->
    <Style Selector="Border.QuoteBlock">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <!-- 系统通知默认保持扁平；错误使用 DESIGN.md 的 Amber Wash 卡片（10px 圆角、
         1px 发丝边、14/10 内边距），与助手正文一样占满整行。 -->
    <Style Selector="Border.SystemNoticeCard">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusCards}" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.SystemNoticeCard.Error">
      <Setter Property="Background" Value="{DynamicResource BrushAmberWash}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrushAmberPin}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <!-- 系统状态行（中断/实体变更/压缩等）：13px，比正文小一档，但比旧 12px 更易读。
         所有系统状态共用这一套排版，避免中断、实体变更各长一套。 -->
    <Style Selector="TextBlock.SystemNoticeText">
      <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="20" />
      <Setter Property="Foreground" Value="{DynamicResource BrushSageGray}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="SelectableTextBlock.SystemNoticeText">
      <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="20" />
      <Setter Property="Foreground" Value="{DynamicResource BrushSageGray}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
    <!-- ═══════════ 对话流（用户右对齐但无宽度上限 / 助手 Markdown 满宽 / 步骤与来源满宽） ═══════════ -->
    <Grid Grid.Row="0">
      <!--
        空状态（工作台引导区）。
        居中排版（衬线标题 + 纯动词快捷操作，无装饰 emoji）。
      -->
      <StackPanel
        MaxWidth="560"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="6"
        IsVisible="{Binding HasMessages, Converter={StaticResource InvertedBoolToVisibility}}"
        motion:Motion.Enter="True"
      >
        <!-- 这一屏唯一的衬线锚点 -->
        <TextBlock
          FontFamily="{StaticResource FontSerif}"
          FontSize="44"
          FontWeight="Light"
          LineHeight="52"
          Foreground="{DynamicResource BrushForestInk}"
          HorizontalAlignment="Center"
          TextAlignment="Center"
          Text="开始创作"
        />

        <TextBlock
          FontSize="14"
          Foreground="{DynamicResource BrushSageGray}"
          HorizontalAlignment="Center"
          TextAlignment="Center"
          Text="输入创作指令，或从快捷操作开始。"
          TextWrapping="Wrap"
        />

        <Border Height="1" Margin="0,16,0,0" Background="{DynamicResource BrushMist}" />

        <!-- 快捷操作：点击预填输入框。纯动词，无装饰字形 -->
        <WrapPanel Margin="0,16,0,0" ItemSpacing="8" LineSpacing="8" HorizontalAlignment="Center">
          <Button
            Classes="Ghost"
            Padding="14,7"
            Click="QuickAction_OnClick"
            Tag="写一章"
            Content="写一章"
          />
          <Button
            Classes="Ghost"
            Padding="14,7"
            Click="QuickAction_OnClick"
            Tag="建角色"
            Content="建角色"
          />
          <Button
            Classes="Ghost"
            Padding="14,7"
            Click="QuickAction_OnClick"
            Tag="埋伏笔"
            Content="埋伏笔"
          />
          <Button
            Classes="Ghost"
            Padding="14,7"
            Click="QuickAction_OnClick"
            Tag="查设定"
            Content="查设定"
          />
          <Button
            Classes="Ghost"
            Padding="14,7"
            Click="QuickAction_OnClick"
            Tag="续写"
            Content="续写"
          />
        </WrapPanel>

        <TextBlock
          FontFamily="{StaticResource FontMono}"
          FontSize="11"
          Foreground="{DynamicResource BrushSageMist}"
          Margin="0,16,0,0"
          HorizontalAlignment="Center"
          TextAlignment="Center"
          Text="@ 引用文件 · / 唤起命令 · Enter 发送 · 右侧面板查看设定"
        />
      </StackPanel>

      <!-- 消息流（有消息才显示，避免透明列表覆盖空状态）。
           不用 VirtualizingStackPanel：stock VSP 的 extent 只按当前 realized 窗口估算，
           对话行高度差异极大（10k 字用户气泡 + 长表格）时，ScrollToEnd 触发的 realize 会让
           估算在 30k↔67k px 间来回，offset 被 anchor/coerce 反复拉回，滚动条无限上下跳。
           Avalonia issue #11989 记录了这个行为，官方 workaround 是可变高度列表退回 StackPanel。
           这里用 StackPanel + 上下 spacer：全量行模型只保留数据，视口窗口外的历史只占高度，
           窗口内全部是 LiveMarkdown；滚动条覆盖 2000 条完整历史。 -->
      <ScrollViewer
        x:Name="MessageScroll"
        IsVisible="{Binding HasMessages}"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        Padding="24,18,24,12"
      >
        <controls:AutoScrollItemsControl
          x:Name="MessageList"
          ItemTemplate="{StaticResource ConversationRowRoot}"
        >
          <controls:AutoScrollItemsControl.Template>
            <ControlTemplate TargetType="controls:AutoScrollItemsControl">
              <!--
                虚拟化窗口的三段式：未实例化历史只占高度，可见窗口才创建 LiveMarkdown。
                spacer 不做数据项，避免窗口换页时 Reset 触发“强制跟随底部”。
              -->
              <StackPanel>
                <Border Height="{TemplateBinding TopSpacerHeight}" />
                <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                <Border Height="{TemplateBinding BottomSpacerHeight}" />
              </StackPanel>
            </ControlTemplate>
          </controls:AutoScrollItemsControl.Template>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </controls:AutoScrollItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- ═══════════ 输入区 ═══════════ -->
    <Border
      Grid.Row="1"
      BorderBrush="{DynamicResource BrushMist}"
      BorderThickness="0"
      Padding="24,10,24,14"
    >
      <StackPanel Spacing="8">
        <!-- TextBox 模板在 TextPresenter 外还有固定 5px 内缩；卡片左侧用 11px
             抵消，使输入文字与正文左缘（16px 卡片内边距 + 1px 边框）对齐。 -->
        <Border
          x:Name="InputCard"
          Classes="Card Glow"
          CornerRadius="{StaticResource RadiusCards}"
          Padding="11,8"
          MinHeight="60"
        >
          <Grid RowDefinitions="Auto,Auto">
            <!-- @ 文件路径 / # 实体引用补全弹窗（锚定输入卡片：上方 + 左右等宽） -->
            <Popup
              x:Name="SuggestionPopup"
              PlacementTarget="{Binding ElementName=InputCard}"
              Placement="TopEdgeAlignedLeft"
              Width="{Binding Bounds.Width, ElementName=InputCard}"
              IsLightDismissEnabled="True"
              IsOpen="{Binding IsSuggestionPopupVisible, Mode=TwoWay}"
              motion:Motion.PopupEnter="True"
            >
              <Border Classes="Card Glow" Padding="6">
                <ListBox
                  x:Name="SuggestionList"
                  Background="Transparent"
                  MaxHeight="260"
                  ItemsSource="{Binding Suggestions}"
                  SelectedIndex="{Binding SelectedSuggestionIndex}"
                  ItemContainerTheme="{StaticResource AdalineRowContainer}"
                  motion:Motion.Stagger="True"
                >
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:FileSystemItem">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="2,3">
                        <lucide:LucideIcon
                          Grid.Column="0"
                          Kind="{Binding IconKind}"
                          Size="14"
                          StrokeWidth="1.6"
                          Foreground="{DynamicResource BrushSageLeaf}"
                          VerticalAlignment="Center"
                        />
                        <TextBlock
                          Grid.Column="1"
                          Text="{Binding Name}"
                          FontSize="14"
                          FontWeight="Medium"
                          TextTrimming="CharacterEllipsis"
                          VerticalAlignment="Center"
                        />
                        <TextBlock
                          Grid.Column="2"
                          Text="{Binding FullPath}"
                          MaxWidth="150"
                          FontFamily="{StaticResource FontMono}"
                          FontSize="11"
                          Foreground="{DynamicResource BrushSageMist}"
                          TextTrimming="CharacterEllipsis"
                          VerticalAlignment="Center"
                        />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </Popup>

            <!-- 斜杠命令补全弹窗 -->
            <Popup
              Grid.Row="0"
              x:Name="CommandPopup"
              PlacementTarget="{Binding ElementName=InputCard}"
              Placement="TopEdgeAlignedLeft"
              Width="{Binding Bounds.Width, ElementName=InputCard}"
              IsLightDismissEnabled="True"
              IsOpen="{Binding IsCommandPopupVisible, Mode=TwoWay}"
              motion:Motion.PopupEnter="True"
            >
              <Border Classes="Card Glow" Padding="6">
                <ListBox
                  x:Name="CommandList"
                  Background="Transparent"
                  MaxHeight="220"
                  ItemsSource="{Binding CommandSuggestions}"
                  SelectedIndex="{Binding SelectedCommandIndex}"
                  ItemContainerTheme="{StaticResource AdalineRowContainer}"
                  motion:Motion.Stagger="True"
                >
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock
                        Text="{Binding}"
                        FontFamily="{StaticResource FontMono}"
                        FontSize="14"
                        Margin="2,3"
                      />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </Popup>

            <TextBox
              x:Name="InputBox"
              Grid.Row="0"
              Classes="PromptBox"
              Text="{Binding InputText}"
              PlaceholderText="{Binding PlaceholderText}"
              AcceptsReturn="True"
              TextWrapping="Wrap"
              MinHeight="44"
              MaxHeight="150"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              KeyDown="InputBox_OnKeyDown"
              TextChanged="InputBox_OnTextChanged"
            />

            <StackPanel
              Grid.Row="1"
              Orientation="Horizontal"
              HorizontalAlignment="Right"
              Spacing="10"
              Margin="0,6,0,0"
            >
              <Button
                x:Name="StopButton"
                Classes="Ghost"
                Command="{Binding StopProcessingCommand}"
                IsVisible="{Binding IsBusy}"
                motion:Motion.Fade="True"
              >
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <lucide:LucideIcon
                    Kind="CircleStop"
                    Size="13"
                    StrokeWidth="1.8"
                    VerticalAlignment="Center"
                  />
                  <TextBlock Text="停止" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button
                x:Name="SendButton"
                Classes="Primary"
                Command="{Binding SendMessageCommand}"
                Click="SendButton_OnClick"
                IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolToVisibility}}"
                motion:Motion.Fade="True"
              >
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="发送" VerticalAlignment="Center" />
                  <lucide:LucideIcon
                    Kind="CornerDownLeft"
                    Size="13"
                    StrokeWidth="1.8"
                    VerticalAlignment="Center"
                  />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        <TextBlock
          Text="Enter 发送 · Shift+Enter 换行 · / 命令补全 · @ 引用文件 · # 引用任意设定 · Ctrl+K 命令面板 · Esc 中断"
          Classes="Tag"
          Foreground="{DynamicResource BrushSageMist}"
        />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
