{
  "LLM": {
    "Provider": "mock",
    "Model": "gpt-4o-mini",
    "ApiKey": "${OPENAI_API_KEY}"
  },
  "Data": {
    "StoreMode": "direct"
  },
  "Agent": {
    "SystemPrompt": "",
    "ThinkingLevel": "medium",
    "ToolSearchDeferredPlugins": "Semantic Retrieval Tool,Web Search Tools"
  },
  "WebSearch": {
    "Provider": "Bing",
    "ApiKey": "${BING_API_KEY}",
    "RateLimitPerSecond": 1
  },
  "Novels": {
    "Path": ""
  }
,
  "CloudDiagnosis": {
    "Enabled": true,
    "DeepBudgetPerSession": 100,
    "DeepBudgetPerNovel": 100,
    "RequestTimeoutSeconds": 15,
    "DecisionTimeoutSeconds": 120,
    "PassScoreThreshold": 62,
    "MonotonyChapterThreshold": 8,
    "MonotonyFlatWindow": 5
  }
}
