<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\Core\Core.csproj">
      <!-- Core.dll 是共享依赖，由 Host 主程序加载，不需要复制到插件目录 -->
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**</DefaultItemExcludes>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- 插件元数据 — plugin.json 的数据源 -->
    <Version>1.0.0</Version>
    <PluginId>semantic-retrieval-tool</PluginId>
    <PluginName>Semantic Retrieval Tool</PluginName>
    <PluginDescription>语义检索工具：搜索记忆、检索角色、检索情节、一致性检查</PluginDescription>
    <PluginAuthor>mythology</PluginAuthor>
    <PluginMinCoreVersion>1.0.0</PluginMinCoreVersion>
    <PluginPermissions>novel:read;vector:read;cloud:harness</PluginPermissions>

    <!-- 输出路径 -->
    <OutputPath>../../Host/bin/$(Configuration)/$(TargetFramework)/plugins/semantic-retrieval-tool</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
</Project>
