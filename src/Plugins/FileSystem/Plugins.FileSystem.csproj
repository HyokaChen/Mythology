<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\Core\Core.csproj">
      <!-- Core.dll 是共享依赖，由 Host 主程序加载，不需要复制到插件目录 -->
      <Private>false</Private>
    </ProjectReference>
    <PackageReference
      Include="Microsoft.Extensions.DependencyInjection.Abstractions"
      Version="10.0.13"
    />
  </ItemGroup>
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**</DefaultItemExcludes>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- 插件元数据 — plugin.json 的数据源 -->
    <Version>1.0.0</Version>
    <PluginId>filesystem-tools</PluginId>
    <PluginName>FileSystem Tools</PluginName>
    <PluginDescription>核心文件操作工具集：读取、写入、编辑、执行命令、任务管理、用户交互</PluginDescription>
    <PluginAuthor>mythology</PluginAuthor>
    <PluginMinCoreVersion>1.0.0</PluginMinCoreVersion>
    <PluginPermissions>fs:access;process:execute;ui:interact</PluginPermissions>

    <!-- 输出路径 -->
    <OutputPath>../../Host/bin/$(Configuration)/$(TargetFramework)/plugins/filesystem-tools</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
</Project>
