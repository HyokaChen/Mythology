<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\Core\Core.csproj">
      <!-- Core.dll 是共享依赖，由 Host 主程序加载，不需要复制到插件目录 -->
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
  </ItemGroup>
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**</DefaultItemExcludes>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- 插件元数据 — plugin.json 的数据源 -->
    <Version>1.0.0</Version>
    <PluginId>web-search-tools</PluginId>
    <PluginName>Web Search Tools</PluginName>
    <PluginDescription>网络搜索工具：搜索、读取网页、查找评论、查词、推荐</PluginDescription>
    <PluginAuthor>mythology</PluginAuthor>
    <PluginMinCoreVersion>1.0.0</PluginMinCoreVersion>
    <PluginPermissions>config:read;net:access</PluginPermissions>

    <!-- 输出路径 -->
    <OutputPath>../../Host/bin/$(Configuration)/$(TargetFramework)/plugins/web-search-tools</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
</Project>
