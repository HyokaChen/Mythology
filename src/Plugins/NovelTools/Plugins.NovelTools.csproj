<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\Core\Core.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\ClientPlatform\ClientPlatform.csproj">
      <!-- 共享依赖：由 Host 主程序加载（与 Core 同法）。复制进插件目录会留下过期副本，
           PluginLoader 逐 DLL 探测时会因接口版本漂移报 TypeLoadException。 -->
      <Private>false</Private>
    </ProjectReference>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>NovelTools.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**</DefaultItemExcludes>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <Version>4.1.0</Version>
    <PluginId>novel-writing-tools</PluginId>
    <PluginName>Novel Writing Tools</PluginName>
    <PluginDescription>小说创作核心工具集</PluginDescription>
    <PluginAuthor>mythology</PluginAuthor>
    <PluginMinCoreVersion>1.0.0</PluginMinCoreVersion>
    <PluginPermissions>novel:read;novel:write;cloud:harness</PluginPermissions>

    <OutputPath>../../Host/bin/$(Configuration)/$(TargetFramework)/plugins/novel-writing-tools</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
</Project>
