<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**</DefaultItemExcludes>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>StabilityHarness</RootNamespace>
    <PackageId>StabilityHarness</PackageId>
    <Version>1.0.0</Version>
    <Description>高性能 AI 代理稳定性监控（Lyapunov 方法）</Description>
    <PackageTags>ai;llm;stability;monitoring;lyapunov;performance</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <!-- jieba.NET 词典资源：检索评测需要分词，与 Core 同款拷贝（NuGet 包内的 Resources/ → 输出目录） -->
  <Target Name="CopyJiebaResources" AfterTargets="Build">
    <PropertyGroup>
      <JiebaResourcesSource>$([MSBuild]::NormalizeDirectory('$(NuGetPackageRoot)', 'jieba.net', '0.42.2', 'Resources'))</JiebaResourcesSource>
      <JiebaResourcesDest>$([MSBuild]::NormalizeDirectory('$(OutputPath)', 'Resources'))</JiebaResourcesDest>
    </PropertyGroup>
    <ItemGroup>
      <JiebaResourceFiles Include="$(JiebaResourcesSource)*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(JiebaResourceFiles)" DestinationFolder="$(JiebaResourcesDest)" SkipUnchangedFiles="true" />
  </Target>
</Project>
